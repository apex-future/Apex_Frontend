# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
dev-dist
*.local

# Environment variables
# .env and .env.local contain secrets — never commit
.env.local
.env.*.local
# .env, .env.development, .env.production are safe to commit (no secrets)
!.env
!.env.development
!.env.production
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Build and lint logs
build_*.log
build_*.txt
*lint*.txt
*lint*.json

# Generated at build time by copy-pdf-worker plugin
public/pdf.worker.min.mjs
